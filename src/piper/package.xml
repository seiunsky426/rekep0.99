<?xml version="1.0"?>
<package format="2">
  <name>piper</name>
  <version>0.1.0</version>
  <description>Minimal real-hardware ROS1 driver surface used by ReKep-Piper.</description>
  <maintainer email="agilex@todo.todo">AgileX Robotics</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>piper_msgs</depend>
  <depend>rekpiper_acceptance</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>piper_description</exec_depend>
  <exec_depend>rekpiper_execution</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosnode</exec_depend>
</package>
