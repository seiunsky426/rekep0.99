<?xml version="1.0"?>
<package format="2">
  <name>rekpiper_execution</name>
  <version>0.1.0</version>
  <description>Official ReKep short-horizon execution on a real Piper arm.</description>
  <maintainer email="zhengsihze@example.com">zhengsihze</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>interactive_markers</depend>
  <depend>visualization_msgs</depend>
  <depend>piper_msgs</depend>
  <depend>rekpiper_acceptance</depend>
  <depend>rekpiper_planning</depend>
  <exec_depend>rekpiper_grasp</exec_depend>
  <exec_depend>rekpiper_camera</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>
  <depend>rekpiper_mapping</depend>
  <depend>rekpiper_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export/>
</package>
