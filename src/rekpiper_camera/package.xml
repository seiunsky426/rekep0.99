<?xml version="1.0"?>
<package format="2">
  <name>rekpiper_camera</name>
  <version>0.1.0</version>
  <description>Live dual-D435 acquisition, projection, fusion, and accepted extrinsics.</description>
  <maintainer email="zhengsihze@example.com">zhengsihze</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>rekpiper_acceptance</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>tf</exec_depend>

  <export/>
</package>
