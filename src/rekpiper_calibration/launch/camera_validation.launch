<?xml version="1.0"?>
<launch>
  <arg name="target_frames" default="30"/>
  <arg name="output_path" default="/tmp/rekep_d435_camera_validation.json"/>
  <arg name="rgb_topic" default="/camera/color/image_raw"/>
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/color/camera_info"/>
  <arg name="expected_serial" default=""/>
  <arg name="serial_param" default=""/>
  <arg name="expected_frame_id" default=""/>
  <node pkg="rekpiper_calibration" type="camera_validation_node.py"
        name="camera_validation" output="screen" required="false">
    <param name="target_frames" value="$(arg target_frames)"/>
    <param name="output_path" value="$(arg output_path)" type="str"/>
    <param name="rgb_topic" value="$(arg rgb_topic)" type="str"/>
    <param name="depth_topic" value="$(arg depth_topic)" type="str"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)" type="str"/>
    <param name="expected_serial" value="$(arg expected_serial)" type="str"/>
    <param name="serial_param" value="$(arg serial_param)" type="str"/>
    <param name="expected_frame_id" value="$(arg expected_frame_id)" type="str"/>
  </node>
</launch>
